<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fpt.mirrorlink.android"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />

    <!-- переключение лаунчеров и запуск системных экранов -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.GET_TASKS" />

    <application
        android:label="Переключатель"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:label="Переключатель"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- HOME-режим (необязательно). Пока выключен, кнопка «Домой»
             работает как обычно. Включается командой:
               adb shell pm enable com.fpt.mirrorlink.android/.HomeAlias
             Выключается:
               adb shell pm disable com.fpt.mirrorlink.android/.HomeAlias -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Переключатель (Домой)">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Второе имя той же активности: некоторые оболочки ищут именно
             com.fpt.mirrorlink.android.MirrorLinkActivity -->
        <activity-alias
            android:name="com.fpt.mirrorlink.android.MirrorLinkActivity"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="Переключатель">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
