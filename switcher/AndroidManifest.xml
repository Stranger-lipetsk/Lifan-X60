<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fpt.mirrorlink.android"
    android:versionCode="2"
    android:versionName="2.0">

    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />

    <!-- переключение лаунчеров и запуск системных экранов -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.GET_TASKS" />

    <application
        android:label="Переключатель"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:label="Переключатель"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- внешний запуск: панель сразу открывает рабочий стол Android.
                 Нужен, чтобы попасть в Android без штатной кнопки MirrorLink. -->
            <intent-filter>
                <action android:name="com.fpt.mirrorlink.android.START_ANDROID" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <!-- HOME-режим. ВКЛЮЧЁН по умолчанию: это главный вход в Android,
             который не зависит от штатной кнопки MirrorLink.
             При загрузке Android выбор домашнего экрана даст два пункта —
             выбираем «Переключатель (Домой)» и «Всегда».
             Вернуть штатное поведение:
               adb shell pm disable com.fpt.mirrorlink.android/.HomeAlias
             Включить обратно:
               adb shell pm enable com.fpt.mirrorlink.android/.HomeAlias -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="Переключатель (Домой)">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Второе имя той же активности: некоторые оболочки ищут именно
             com.fpt.mirrorlink.android.MirrorLinkActivity -->
        <activity-alias
            android:name="com.fpt.mirrorlink.android.MirrorLinkActivity"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="Переключатель">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
