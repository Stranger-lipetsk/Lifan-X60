# Android fstab file.
#<src>                                                  <mnt_point>         <type>    <mnt_flags and options>                       <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#/devices/platform/sdhci-esdhc-imx.3/mmc_host/mmc1 /mnt/media_rw/extsd vfat defaults voldmanaged=extsd:auto
/devices/platform/fsl-ehci.1/usb2/2-1/2-1.1 /mnt/media_rw/usb1 vfat defaults voldmanaged=usb1:auto
/devices/platform/fsl-ehci.1/usb2/2-1/2-1.2 /mnt/media_rw/usb2 vfat defaults voldmanaged=usb2:auto

#/dev/block/mmcblk1p3    /system      ext4    rw                                                                               wait
#/dev/block/mmcblk1p4    /data        ext4    nosuid,nodev,nodiratime,noatime,nomblk_io_submit,noauto_da_alloc,errors=panic    wait,encryptable=footer
/dev/block/mmcblk1p1    /fw_data     vfat    rw                                                                               wait